.venv/
__pycache__/
*.pyc
.env
.ipynb_checkpoints/

# Outputs: by default ignored, but track reproducibility artefacts explicitly.
outputs/*
!outputs/hardware_run.json
!outputs/hardware_run_defi.json
!outputs/backtest.json
!outputs/signed_orders.json
!outputs/unsigned_monad_tx.json
!outputs/unsigned_anchor_tx.json
# The anchor transaction that actually executed on mainnet, fetched from
# chain. verify_claims.py recomputes the shipped order against it, so CI
# needs it present.
!outputs/executed_anchor_tx.json
!outputs/unsigned_alloc_tx.json
!outputs/audit_log.jsonl
!outputs/p_optimal.png
!outputs/backtest_equity.png

# Signing secrets — never commit. Fail-closed: everything under keys/ is
# ignored by default so a newly-added secret cannot leak by omission; the
# PUBLIC keys are then explicitly re-included, because a verifier needs them
# to pin the agent identity (audit M-1). Publishing a public key is safe and
# is what makes the shipped artefacts independently verifiable.
keys/*
!keys/*.pub

# Foundry build artefacts and dependencies.
contracts/out/
contracts/cache/
contracts/lib/
contracts/broadcast/
# Mini-repo init for `forge install` — not the actual repo
contracts/.git/

# Sealed keystores — encrypted, but keep them out of the repo anyway.
*.keystore.json
agent-identity*.json

# SP1 guest build output. Reproducible from zk-mldsa/program/, and the
# committed vkey is what pins the program identity, not this binary.
zk-mldsa/elf/

# Foundry deps for the zk-mldsa contracts project (installed via forge install).
zk-mldsa/contracts/lib/forge-std/
zk-mldsa/contracts/out/
zk-mldsa/contracts/cache/

# Local Chromium fetched for marp PDF rendering (not source).
chrome/

# Internal funding-application draft — not for publication.
docs/STAGE2_APPLICATION.md
