.venv/
__pycache__/
*.pyc
.env
.ipynb_checkpoints/

# Outputs: by default ignored, but track reproducibility artefacts explicitly.
outputs/*
!outputs/hardware_run.json
!outputs/hardware_run_defi.json
# The 2026-08-17 matched CVaR/mean pair on ibm_marrakesh. SUBMISSION.md cites
# both by filename and quotes their P(optimal) figures, so a reviewer cloning
# the repo has to receive them — under `outputs/*` they would have been cited
# but never shipped. This allowlist is fail-closed by design: new evidence has
# to be admitted deliberately, and evidence a document names is not optional.
!outputs/hardware_run_cvar0p5.json
!outputs/hardware_run_mean_20260817.json
!outputs/backtest.json
!outputs/signed_orders.json
# mainnet_route_order.json is deliberately NOT tracked: it was a schema-v1
# snapshot with no execution block, matching nothing on chain, referenced by no
# doc or script. A reviewer opening it looking for "the mainnet route order"
# would find an order unrelated to any deployed transaction. The route order
# that WAS anchored is signed_orders.json (0xaee5fdf0...).
!outputs/mainnet_supply_order.json
# Raw counts + job IDs for all 10 replication pairs, so the negative
# result recomputes without an IBM account — same standard as the
# positive results it corrects.
!outputs/replication_marrakesh.json
!outputs/replication_marrakesh_interleaved.json
!outputs/unsigned_monad_tx.json
!outputs/unsigned_anchor_tx.json
# The anchor transaction that actually executed on mainnet, fetched from
# chain. verify_claims.py recomputes the shipped order against it, so CI
# needs it present.
!outputs/executed_anchor_tx.json
!outputs/unsigned_alloc_tx.json
# The yield leg is its own PQ-signed order with its own orderHash (AuditAnchorV2
# stores one commitment per (user, orderHash), so the two legs cannot share
# one). Without this file a reviewer can recompute the routing leg from
# signed_orders.json but has NO artefact for the supply leg — half the shipped
# loop would be unverifiable from a cold clone. Public data only: order,
# signatures, public key.
!outputs/mainnet_supply_order.json
# Raw counts + job IDs for all 10 replication pairs, so the negative
# result recomputes without an IBM account — same standard as the
# positive results it corrects.
!outputs/replication_marrakesh.json
!outputs/replication_marrakesh_interleaved.json
!outputs/audit_log.jsonl
!outputs/p_optimal.png
# Embedded in README.md. Generated by `make charts`, but gitignored and never
# allowlisted, so the README's only chart — the headline mitigation result —
# rendered as a broken image on GitHub for anyone reading the repository.
!outputs/hardware_vs_noise_stocks.png
!outputs/backtest_equity.png

# Signing secrets — never commit. Fail-closed: everything under keys/ is
# ignored by default so a newly-added secret cannot leak by omission; the
# PUBLIC keys are then explicitly re-included, because a verifier needs them
# to pin the agent identity (audit M-1). Publishing a public key is safe and
# is what makes the shipped artefacts independently verifiable.
keys/*
!keys/*.pub

# Foundry build artefacts and dependencies.
contracts/out/
contracts/cache/
contracts/lib/
contracts/broadcast/
# Mini-repo init for `forge install` — not the actual repo
contracts/.git/

# Sealed keystores — encrypted, but keep them out of the repo anyway.
*.keystore.json
agent-identity*.json

# SP1 guest build output. Reproducible from zk-mldsa/program/, and the
# committed vkey is what pins the program identity, not this binary.
zk-mldsa/elf/

# Foundry deps for the zk-mldsa contracts project (installed via forge install).
zk-mldsa/contracts/lib/forge-std/
zk-mldsa/contracts/out/
zk-mldsa/contracts/cache/

# Local Chromium fetched for marp PDF rendering (not source).
chrome/

# Internal funding-application draft — not for publication.
docs/STAGE2_APPLICATION.md
