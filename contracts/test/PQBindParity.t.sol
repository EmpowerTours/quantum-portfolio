pragma solidity 0.8.28;
import { Test } from "forge-std/Test.sol";
import { PQExecBinding } from "../src/PQExecBinding.sol";

/// Parity + extraction against a REAL schema-v3 order produced by
/// src/pq_signing.canonical_bytes — not a hand-written fixture.
contract PQBindParity is Test {
    bytes constant PREIMAGE = hex"";
    bytes32 constant ORDER_HASH =
        0x0b78b8236242f87457d992a7bf288e8ad2db0da30f4665d9ab8f1387cc9f7320;
    bytes32 constant SIGNED_COMMITMENT =
        0x9063d5889230c9af869686e63d26cd57dca1b6adf62ce9fc3e7f00eb065b3ba3;

    function _sig(bytes calldata p, bytes32 h) external pure returns (bytes32) {
        return PQExecBinding.signedCommitment(p, h);
    }

    function test_ExtractsTheSignedCommitmentFromARealOrder() public view {
        assertEq(this._sig(PREIMAGE, ORDER_HASH), SIGNED_COMMITMENT);
    }

    function test_RejectsAPreimageThatDoesNotHashToTheOrderHash() public {
        vm.expectRevert();
        this._sig(PREIMAGE, bytes32(uint256(1)));
    }

    function test_RouteParamsHashMatchesPython() public pure {
        address[] memory t = new address[](1);
        t[0] = 0x754704Bc059F8C67012fEd69BC8A327a5aafb603;
        uint24[] memory f = new uint24[](1); f[0] = 3000;
        uint16[] memory w = new uint16[](1); w[0] = 10000;
        uint256[] memory m = new uint256[](1); m[0] = 2118;
        assertEq(
            keccak256(abi.encode(uint256(143),
                0x06F233062eE23590e5CC873df511024f3d981e56,
                0x8dF64bACf6b70F7787f8d14429b258B3fF958ec1,
                t, f, w, uint256(100000000000000000), m, uint256(1785436298))),
            SIGNED_COMMITMENT,
            "Solidity must match src/monad_tx.route_params_hash"
        );
    }
}
